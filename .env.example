# Copy this file to `.env` and adjust the values for your environment.
# `.env` is gitignored — never commit real credentials.

# --- MongoDB root (admin) ---
# Used by Docker to bootstrap the server. Has full admin rights.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_root

# --- MongoDB application user ---
# Created automatically on first startup by the init script.
# Scoped to MONGO_DATABASE only (readWrite + dbAdmin).
MONGO_USERNAME=solar_user
MONGO_PASSWORD=change_me
MONGO_DATABASE=SolarMonitoringDb
MONGO_PORT=27017

# --- mongo-express (web UI) ---
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin

# --- HiveMQ / MQTT ---
# Override the API's appsettings via env. ASP.NET Core reads
# Mqtt__* automatically (note the double underscore).
Mqtt__Host=broker.hivemq.com
Mqtt__Port=8883
Mqtt__UseTls=true
Mqtt__Username=
Mqtt__Password=
Mqtt__Topic=solar/+/telemetry
Mqtt__PersistCron=0 * * * * ?
